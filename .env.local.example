# Copy this file to .env.local (already git-ignored) and adjust if needed.
#
# Points straight at the live Render backend by default -- no need to run
# the Django server locally just to work on this frontend. Render's free
# plan spins the backend down after 15 minutes idle, so the first request
# after a quiet period will be slow (10-30s) while it wakes back up.
NEXT_PUBLIC_API_URL=https://kalingapp-backend.onrender.com
